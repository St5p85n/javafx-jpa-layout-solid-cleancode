<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gl.gestionproduits.HelloController">
   <top>
      <Pane prefHeight="70.0" prefWidth="600.0" style="-fx-background-color: black;" BorderPane.alignment="CENTER">
         <children>
            <MenuBar layoutX="223.0" layoutY="22.0">
              <menus>
                <Menu mnemonicParsing="false" text="Accueil">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Close" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Categorie">
                  <items>
                    <MenuItem onAction="#afficheAjoutCategorie" mnemonicParsing="false" text="Ajout categorie" />
                      <MenuItem onAction="#afficheListeCategorie" mnemonicParsing="false" text="Lister categorie" />

                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Produit">
                  <items>
                    <MenuItem mnemonicParsing="false" text="About" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
         </children>
      </Pane>
   </top>
    <center>
        <StackPane fx:id="stackPane"></StackPane>
    </center>

</BorderPane>
